{
  "name": "trace-pack",
  "version": "0.2.0",
  "private": true,
  "description": "Minimal LLM observability dashboard for Claude-based apps. Companion to @zeroindex-ai/eval-pack.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.1",
    "undici": "^8.9.0",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^6",
    "vite": "^8.2.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zeroindex-ai/trace-pack.git"
  },
  "homepage": "https://github.com/zeroindex-ai/trace-pack#readme",
  "bugs": {
    "url": "https://github.com/zeroindex-ai/trace-pack/issues"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "postcss@<8.5.23": ">=8.5.23",
      "brace-expansion@<1.1.18": ">=1.1.18 <2",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7 <6",
      "browserslist@<4.28.7": ">=4.28.7",
      "js-yaml@<4.3.1": ">=4.3.1 <5",
      "sharp@<0.35.0": ">=0.35.0",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0"
    }
  }
}
